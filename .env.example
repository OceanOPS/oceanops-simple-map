# Flat basemaps (Plate Carrée / Equal Earth) — required in production.
# Root of the pyramid on the oceanops-basemap-tiles service (must end with /tiles).
# Local Docker: http://localhost:8081/tiles
# Production:  https://basemap-tiles.<your-domain>/tiles
VITE_FLAT_BASEMAP_TILES_URL=https://basemap-tiles.example.org/tiles

# MapServer-only on flat projections (no tile service):
# VITE_FLAT_BASEMAP_TILES_URL=off
